{#
アフィリエイター登録フォーム（フロント）
#}
{% extends 'default_frame.twig' %}

{% block main %}
<div class="ec-role">
    <div class="ec-pageHeader">
        <h1>アフィリエイト登録</h1>
    </div>

    <p class="ec-para-normal">
        以下のフォームからお申し込みください。管理者の承認後、ご紹介用URLをメールでお送りします。
    </p>

    <form method="post" action="{{ url('affiliate_entry') }}">
        {{ form_widget(form._token) }}
        <div class="ec-borderedDefs">
            <dl>
                <dt>{{ form_label(form.name) }}</dt>
                <dd>{{ form_widget(form.name) }}{{ form_errors(form.name) }}</dd>
            </dl>
            <dl>
                <dt>{{ form_label(form.email) }}</dt>
                <dd>{{ form_widget(form.email) }}{{ form_errors(form.email) }}</dd>
            </dl>
            <dl>
                <dt>{{ form_label(form.bank_name) }}</dt>
                <dd>{{ form_widget(form.bank_name) }}{{ form_errors(form.bank_name) }}</dd>
            </dl>
            <dl>
                <dt>{{ form_label(form.bank_branch) }}</dt>
                <dd>{{ form_widget(form.bank_branch) }}{{ form_errors(form.bank_branch) }}</dd>
            </dl>
            <dl>
                <dt>{{ form_label(form.account_type) }}</dt>
                <dd>{{ form_widget(form.account_type) }}{{ form_errors(form.account_type) }}</dd>
            </dl>
            <dl>
                <dt>{{ form_label(form.account_number) }}</dt>
                <dd>{{ form_widget(form.account_number) }}{{ form_errors(form.account_number) }}</dd>
            </dl>
            <dl>
                <dt>{{ form_label(form.account_holder) }}</dt>
                <dd>{{ form_widget(form.account_holder) }}{{ form_errors(form.account_holder) }}</dd>
            </dl>
        </div>
        <div class="ec-RegisterRole__actions">
            <div class="ec-off4Grid">
                <div class="ec-off4Grid__cell">
                    <button type="submit" class="ec-blockBtn--action">登録する</button>
                </div>
            </div>
        </div>
    </form>
</div>
{% endblock %}
