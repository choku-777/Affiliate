{#
アフィリエイト設定（管理）
#}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['affiliate', 'affiliate_config'] %}

{% block title %}設定{% endblock %}
{% block sub_title %}アフィリエイト管理{% endblock %}

{% block main %}
<form method="post" action="{{ url('admin_affiliate_config') }}">
    {{ form_widget(form._token) }}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="card rounded border-0 mb-4">
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-4">{{ form_label(form.commission_rate) }}</div>
                            <div class="col-6">{{ form_widget(form.commission_rate) }}{{ form_errors(form.commission_rate) }}</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-4">{{ form_label(form.cookie_lifetime_days) }}</div>
                            <div class="col-6">{{ form_widget(form.cookie_lifetime_days) }}{{ form_errors(form.cookie_lifetime_days) }}</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-4">{{ form_label(form.confirm_after_days) }}</div>
                            <div class="col-6">{{ form_widget(form.confirm_after_days) }}{{ form_errors(form.confirm_after_days) }}</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-4">{{ form_label(form.min_payout_amount) }}</div>
                            <div class="col-6">{{ form_widget(form.min_payout_amount) }}{{ form_errors(form.min_payout_amount) }}</div>
                        </div>
                    </div>
                </div>
                <div class="card rounded border-0 mb-4">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary">保存</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
{% endblock %}
