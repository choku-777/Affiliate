{#
アフィリエイター詳細・承認操作（管理）
#}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['affiliate', 'affiliate_list'] %}

{% block title %}アフィリエイター詳細{% endblock %}
{% block sub_title %}アフィリエイト管理{% endblock %}

{% set status_labels = {
    (constant('Plugin\\Affiliate\\Entity\\Affiliate::STATUS_PENDING')): '申請中',
    (constant('Plugin\\Affiliate\\Entity\\Affiliate::STATUS_APPROVED')): '承認済み',
    (constant('Plugin\\Affiliate\\Entity\\Affiliate::STATUS_REJECTED')): '却下',
    (constant('Plugin\\Affiliate\\Entity\\Affiliate::STATUS_SUSPENDED')): '停止'
} %}

{% block main %}
<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">
            <div class="card rounded border-0 mb-4">
                <div class="card-body">
                    <table class="table">
                        <tr><th>ID</th><td>{{ Affiliate.id }}</td></tr>
                        <tr><th>氏名</th><td>{{ Affiliate.name }}</td></tr>
                        <tr><th>メール</th><td>{{ Affiliate.email }}</td></tr>
                        <tr><th>ステータス</th><td>{{ status_labels[Affiliate.status] ?? Affiliate.status }}</td></tr>
                        <tr><th>アフィリエイトコード</th><td>{{ Affiliate.affiliateCode }}</td></tr>
                        <tr>
                            <th>発行URL</th>
                            <td>
                                {% if Affiliate.isApproved %}
                                    <code>{{ affiliate_url }}</code>
                                {% else %}
                                    <span class="text-muted">承認後に有効になります（{{ affiliate_url }}）</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr><th>銀行名</th><td>{{ Affiliate.bankName }}</td></tr>
                        <tr><th>支店名</th><td>{{ Affiliate.bankBranch }}</td></tr>
                        <tr><th>口座種別</th><td>{{ Affiliate.accountType }}</td></tr>
                        <tr><th>口座番号</th><td>{{ Affiliate.accountNumber }}</td></tr>
                        <tr><th>口座名義</th><td>{{ Affiliate.accountHolder }}</td></tr>
                        <tr><th>申請日</th><td>{{ Affiliate.createDate ? Affiliate.createDate|date('Y-m-d H:i') }}</td></tr>
                        <tr><th>承認日</th><td>{{ Affiliate.approvedDate ? Affiliate.approvedDate|date('Y-m-d H:i') }}</td></tr>
                    </table>
                </div>
            </div>

            <div class="card rounded border-0 mb-4">
                <div class="card-body d-flex" style="gap: 8px;">
                    {% if not Affiliate.isApproved %}
                        <form method="post" action="{{ url('admin_affiliate_approve', {id: Affiliate.id}) }}">
                            <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                            <button type="submit" class="btn btn-primary">承認する</button>
                        </form>
                    {% endif %}
                    {% if Affiliate.status != constant('Plugin\\Affiliate\\Entity\\Affiliate::STATUS_REJECTED') %}
                        <form method="post" action="{{ url('admin_affiliate_reject', {id: Affiliate.id}) }}">
                            <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                            <button type="submit" class="btn btn-outline-danger">却下する</button>
                        </form>
                    {% endif %}
                    {% if Affiliate.isApproved %}
                        <form method="post" action="{{ url('admin_affiliate_suspend', {id: Affiliate.id}) }}">
                            <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                            <button type="submit" class="btn btn-outline-secondary">停止する</button>
                        </form>
                    {% endif %}
                    <a class="btn btn-light" href="{{ url('admin_affiliate') }}">一覧へ戻る</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
