# ───────── アフィリエイト管理サービス 固有の設定 ─────────
# （Laravel標準の .env に以下を追記してください）

APP_NAME="Affiliate"
APP_URL=https://affiliate.tairiku-tsusho.co.jp

# DB（Xserver MySQL / MariaDB）
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=（Xserverで作成したDB名）
DB_USERNAME=（DBユーザー）
DB_PASSWORD=（DBパスワード）

# EC-CUBEプラグインと共有するAPIキー（両方を同じ値にする）
AFFILIATE_API_KEY=（推奨: openssl rand -hex 32 で生成）

# 管理画面のGoogleアカウント（ロール別・カンマ区切り）
# 管理＝全権（設定変更も可） / 運用＝設定変更以外（承認・成果・支払い操作は可）
ADMIN_MANAGER_EMAILS=ec@tairiku-tsusho.co.jp
ADMIN_OPERATOR_EMAILS=（運用担当のGoogleアカウント）

# 発行URLに使うショップのベースURL
SHOP_BASE_URL=https://shizenha-inu.life

# Google OAuth（Google Cloud Consoleで発行）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://affiliate.tairiku-tsusho.co.jp/admin/auth/google/callback

# メール送信（承認通知などに使用）
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@shizenha-inu.life"
MAIL_FROM_NAME="${APP_NAME}"
